rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function ownerOnly(col) {
      return col in ['routines', 'routineChecks', 'checklists'];
    }

    // Members are created by hand in the Firebase console.
    match /members/{uid} {
      allow read: if isMember();
      allow write: if false;
    }

    match /{col}/{id} {
      allow read: if isMember()
        && (col in ['shopping', 'products', 'freezerBags', 'chores', 'expenses', 'meta'] || ownerOnly(col));
      allow write: if isMember()
        && col in ['shopping', 'products', 'freezerBags', 'chores', 'expenses', 'meta'];
      allow create: if isMember() && ownerOnly(col)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isMember() && ownerOnly(col)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isMember() && ownerOnly(col)
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
